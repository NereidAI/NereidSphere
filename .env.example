# OIDC Compose development settings. Copy this file to .env and replace every
# placeholder and reserved example.com origin. Never commit the resulting .env.
# The issuer must be reachable from both the browser and the NS container.
NS_PORT=8081
NS_BASE_URL=http://localhost:8081
NS_OIDC_ISSUER=https://sso.example.com/auth/realms/nereidai
NS_OIDC_CLIENT_ID=nereidsphere
NS_OIDC_CLIENT_SECRET=replace-with-nereidsphere-client-secret
NS_OIDC_ADMIN_CLIENT_ID=nereidsphere-admin
NS_OIDC_ADMIN_CLIENT_SECRET=replace-with-admin-service-account-secret

# Exactly 32 bytes. Replace this development placeholder before real use.
NS_SESSION_SECRET_KEY=dev-insecure-32byte-secret-key!!
# Set to true when NS_BASE_URL uses HTTPS.
NS_SESSION_SECURE=false

# Product origins must be reachable from both the browser and the NS container.
NS_FORGE_URL=https://nereidforge.example.com
NS_HORIZON_URL=https://nereidhorizon.example.com
NS_LINK_URL=https://nereidlink.example.com

# Each value must exactly match the corresponding product's NS ticket secret.
NS_FORGE_SSO_SECRET=replace-with-forge-ticket-secret
NS_HORIZON_SSO_SECRET=replace-with-horizon-ticket-secret
NS_LINK_SSO_SECRET=replace-with-link-ticket-secret
