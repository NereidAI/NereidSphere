{
  "name": "nereidsphere-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --max-http-header-size=32768 node_modules/vite/bin/vite.js",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node -e \"require('fs').writeFileSync('dist/.gitkeep','')\"",
    "preview": "vite preview",
    "lint": "echo \"No lint configured yet\"",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:help": "node scripts/check-help-docs.mjs",
    "check": "npm run check:i18n && npm run check:help",
    "test": "echo \"No tests configured yet\""
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.29.3",
    "axios": "^1.20.0",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^18.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^15.7.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "~5.6.2",
    "vite": "^5.4.10"
  }
}
