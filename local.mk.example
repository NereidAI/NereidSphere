#
# Optional local build acceleration for restricted networks.
#
# Copy this file to local.mk and fill in the endpoints for a restricted or
# regional network:
#
#     cp local.mk.example local.mk
#
# local.mk is git-ignored and must never be committed. With direct internet
# access, leave it absent: every value stays empty, reproducing the pristine
# upstream build that CI runs. This file only populates build variables; the
# Makefile contains no push target regardless of its contents.

# Go module proxy (empty = toolchain default proxy.golang.org).
GOPROXY ?=

# Alpine apk mirror host without scheme/trailing slash (empty = upstream CDN).
ALPINE_MIRROR ?=

# npm registry (empty = registry.npmjs.org).
NPM_REGISTRY ?=
